{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dithercn",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "dither-tokens",
      "type": "registry:item",
      "title": "Dither tokens",
      "description": "CSS variables every dithercn piece reads: ink, paper and cell size, mapped to your shadcn theme tokens.",
      "cssVars": {
        "theme": {
          "color-dither-ink": "var(--dither-ink)",
          "color-dither-paper": "var(--dither-paper)"
        },
        "light": {
          "dither-ink": "var(--primary)",
          "dither-paper": "var(--background)",
          "dither-cell": "3px"
        },
        "dark": {
          "dither-ink": "var(--primary)",
          "dither-paper": "var(--background)",
          "dither-cell": "3px"
        }
      }
    }
  ]
}
